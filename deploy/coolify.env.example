# Copiez ce fichier en "deploy/coolify.env" et remplissez les valeurs.
# Ce fichier réel est ignoré par git (secrets).

# --- Git (Coolify déploie depuis un dépôt Git) ---
GIT_REMOTE=origin
GIT_BRANCH=main

# --- Déclenchement du déploiement Coolify ---
# URL de base de votre instance Coolify (sans slash final)
COOLIFY_BASE_URL=https://coolify.mon-domaine.fr
# Jeton API : Coolify → Keys & Tokens → API tokens (droit "deploy")
COOLIFY_API_TOKEN=
# UUID de l'application dans Coolify (visible dans l'URL de la ressource)
COOLIFY_APP_UUID=
