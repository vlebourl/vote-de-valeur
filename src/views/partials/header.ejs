<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Vote de valeur' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/"><span class="brand-bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span> Vote de valeur</a>
    <nav>
      <% if (user) { %>
        <a href="/dashboard">Mes votes</a>
        <a href="/account/api">API</a>
