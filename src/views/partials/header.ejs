          <button class="link" type="submit">Se déconnecter</button>
        </form>
      <% } else { %>
        <a href="/login">Connexion</a>
        <a class="btn btn-sm" href="/register">Créer un compte</a>
      <% } %>
    </nav>
  </header>
  <main class="container">
