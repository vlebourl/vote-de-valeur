<%
  var maxAbs = 1;
  options.forEach(function (o) { if (Math.abs(o.total) > maxAbs) maxAbs = Math.abs(o.total); });
  var rankCount = {};
  options.forEach(function (o) { rankCount[o.rank] = (rankCount[o.rank] || 0) + 1; });
  var winners = options.filter(function (o) { return o.rank === 1; });
  var rest = options.filter(function (o) { return o.rank !== 1; });
  function pct(o) { return Math.round(Math.abs(o.total) / maxAbs * 100); }
  function fmt(t) { return t > 0 ? '+' + t : String(t); }
  function scoreCls(t) { return t > 0 ? 'pos' : (t < 0 ? 'neg' : ''); }
%>
<% if (winners.length) { %>
  <div class="winner">
    <div class="winner-label">Choix retenu<%= winners.length > 1 ? ' (ex æquo)' : '' %></div>
    <div class="winner-name"><%= winners.map(function (w) { return w.label || '(image)'; }).join(' · ') %></div>
    <div class="winner-score total <%= scoreCls(winners[0].total) %>"><%= fmt(winners[0].total) %></div>
  </div>
<% } %>
<div class="res-list">
  <% rest.forEach(function (o) { %>
    <div class="res-row">
      <div class="res-head">
        <span class="res-rank"><%= o.rank %></span>
        <div class="res-main">
          <% if (o.has_image) { %><img class="opt-thumb" src="/options/<%= o.id %>/image" alt=""><% } %>
          <div>
            <div class="res-name"><%= o.label ? o.label : '(image)' %><% if (rankCount[o.rank] > 1) { %><span class="tie">ex æquo</span><% } %></div>
            <% if (o.description) { %><div class="muted res-desc"><%= o.description %></div><% } %>
          </div>
        </div>
        <span class="res-score total <%= scoreCls(o.total) %>"><%= fmt(o.total) %></span>
      </div>
      <div class="res-bar"><div class="res-bar-fill" style="width:<%= pct(o) %>%;background:<%= o.total < 0 ? 'var(--neg)' : 'var(--indigo)' %>"></div></div>
    </div>
  <% }) %>
</div>
<p class="muted" style="font-size:13px;margin-top:12px">Basé sur <%= ballotCount %> bulletin<%= ballotCount > 1 ? 's' : '' %>. Classement à la somme des notes (−2 à +2) ; abstention comptée comme 0. Les égalités partagent le même rang.</p>
