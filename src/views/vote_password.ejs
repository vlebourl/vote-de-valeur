<%- include('partials/header', { pageTitle: poll.title }) %>
<h1><%= poll.title %></h1>
<p class="muted">Ce vote est privé. Saisissez le mot de passe communiqué par l'organisateur.</p>
<div class="card" style="max-width:440px">
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form method="post" action="/vote/<%= poll.id %>/access">
    <label for="password">Mot de passe</label>
    <input type="password" id="password" name="password" required autofocus>
    <div style="margin-top:18px"><button class="btn" type="submit">Accéder au vote</button></div>
  </form>
</div>
<%- include('partials/footer') %>
