<%- include('partials/header', { pageTitle: 'Résultats — ' + poll.title }) %>
<% var jv = (typeof justVoted !== 'undefined' && justVoted);
   var pl = (typeof permalink !== 'undefined' && permalink) ? permalink : ''; %>
<h1 style="margin-bottom:4px"><%= poll.title %></h1>
<% if (jv) { %><div class="notice">Votre vote a bien été enregistré. Merci !<% if (poll.auth_mode === 'email') { %> Un email de confirmation vous a été envoyé.<% } %></div><% } %>
<% if (typeof justSupplemented !== 'undefined' && justSupplemented) { %><div class="notice">Vos notes pour les nouveaux choix ont bien été enregistrées. Merci !</div><% } %>
<% if (typeof newOptions !== 'undefined' && newOptions.length) { %>
  <div class="card" style="border:2px solid var(--indigo)">
    <p style="margin-top:0"><strong>Nouveau<%= newOptions.length > 1 ? 'x choix' : ' choix' %> depuis votre vote</strong> :
      <%= newOptions.map(function (o) { return o.label || '(image)'; }).join(', ') %>.</p>
    <a class="btn" href="/vote/<%= poll.id %>/ballot/<%= token %>">Noter <%= newOptions.length > 1 ? 'ces choix' : 'ce choix' %></a>
  </div>
<% } %>

<div class="card">
  <div class="row-actions" style="justify-content:space-between">
    <h2 style="margin:0">Résultats</h2>
    <% if (!closed) { %><span class="live-pill"><i></i>En direct</span><% } else { %><span class="badge badge-closed">vote clos</span><% } %>
  </div>
  <div id="results-container" style="margin-top:16px">
    <% if (typeof visible === 'undefined' || visible) { %>
      <%- include('partials/results_table', { options: options, ballotCount: ballotCount, threshold: threshold }) %>
    <% } else { %>
      <%- include('partials/results_hidden', { threshold: threshold, ballotCount: ballotCount }) %>
    <% } %>
  </div>
</div>

<div class="card">
  <h2 style="margin-top:0">Lien permanent des résultats</h2>
  <p class="muted" style="margin-top:0">Votre lien personnel à conserver : il affiche les résultats <strong>en temps réel</strong>, à tout moment.</p>
  <div class="share-box">
    <input type="text" id="pub" value="<%= pl %>" readonly>
    <button class="btn btn-sm" type="button" onclick="navigator.clipboard.writeText(document.getElementById('pub').value)">Copier</button>
  </div>
</div>

<% if (!closed) { %>
<script src="/results.js"></script>
<script>
  (function () {
    var token = <%- JSON.stringify(typeof token !== 'undefined' ? token : null) %>;
    var url = '/api/polls/' + <%- JSON.stringify(poll.id) %> + '/results' + (token ? '?token=' + encodeURIComponent(token) : '');
    vvStartLive({ url: url, containerId: 'results-container' });
  })();
</script>
<% } %>
<%- include('partials/footer') %>
