<%- include('partials/header', { pageTitle: poll.title }) %>
<% const shareUrl = baseUrl.replace(/\/$/, '') + '/vote/' + poll.id; %>

<div class="row-actions" style="justify-content:space-between">
  <h1 style="margin-bottom:4px"><%= poll.title %></h1>
  <a href="/dashboard" class="muted">← Mes votes</a>
</div>
<p>
  <% if (poll.is_private) { %><span class="badge badge-private">privé</span> <% } %>
  <% if (poll.status === 'open') { %><span class="badge badge-open">ouvert</span><% } else { %><span class="badge badge-closed">clos</span><% } %>
</p>
<% if (poll.description) { %><p class="muted"><%= poll.description %></p><% } %>

<% if (typeof notice !== 'undefined' && notice) { %><div class="notice"><%= notice %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>

<div class="card">
  <h2 style="margin-top:0">Partager</h2>
  <p class="muted">Lien du vote à diffuser aux participants :</p>
  <div class="share-box">
    <input type="text" id="share" value="<%= shareUrl %>" readonly>
    <button class="btn btn-sm" onclick="navigator.clipboard.writeText(document.getElementById('share').value)">Copier</button>
  </div>
  <% if (poll.is_private) { %>
    <p class="field-hint">Vote privé : communiquez aussi le mot de passe aux participants (séparément du lien, de préférence).</p>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0">Modifier le vote</h2>
  <% if (ballotCount > 0) { %>
    <div class="error" style="background:#fffbeb;border-color:#fde68a;color:#b45309">
      ⚠ <strong><%= ballotCount %> bulletin<%= ballotCount > 1 ? 's' : '' %></strong> déjà déposé<%= ballotCount > 1 ? 's' : '' %>.
      Le titre et la description restent modifiables sans effet sur les résultats.
      <strong>Ajouter</strong> une option : les votants ayant déjà voté seront comptés comme s'abstenant (0) dessus.
      <strong>Supprimer</strong> une option retire définitivement ses notes de tous les bulletins.
    </div>
  <% } %>

  <form method="post" action="/polls/<%= poll.id %>/edit">
    <label for="title">Titre</label>
    <input type="text" id="title" name="title" value="<%= poll.title %>" required>
    <label for="description">Description (optionnelle)</label>
    <textarea id="description" name="description" placeholder="Contexte, consignes…"><%= poll.description %></textarea>
    <button class="btn btn-sm" type="submit" style="margin-top:10px">Enregistrer le titre / la description</button>
  </form>

  <h3 style="margin:24px 0 4px">Options (<%= options.length %>)</h3>
  <p class="field-hint">Chaque option est notée de −2 à +2 par les votants. Un vote doit conserver au moins 2 options.</p>

  <% options.forEach(function (o) { %>
    <div class="option-block">
      <div class="opt-cell" style="align-items:flex-start;margin-bottom:10px">
        <% if (o.has_image) { %><img class="opt-thumb" src="/options/<%= o.id %>/image" alt=""><% } %>
        <form method="post" action="/polls/<%= poll.id %>/options/<%= o.id %>/edit" style="flex:1;margin:0">
          <input type="text" name="label" value="<%= o.label %>" placeholder="Intitulé (optionnel si image)">
          <input type="text" name="description" value="<%= o.description %>" placeholder="Description (optionnelle)" style="margin-top:8px">
          <button class="btn btn-sm btn-ghost" type="submit" style="margin-top:10px">Enregistrer</button>
        </form>
      </div>
      <form method="post" action="/polls/<%= poll.id %>/options/<%= o.id %>/delete" onsubmit="return confirm('Supprimer définitivement cette option ? Ses notes seront retirées de tous les bulletins.')">
        <button class="btn btn-sm btn-danger" type="submit" <%- options.length <= 2 ? 'disabled title="Un minimum de 2 options est requis"' : '' %>>Supprimer cette option</button>
      </form>
    </div>
  <% }) %>

  <h3 style="margin:24px 0 4px">Ajouter une option</h3>
  <form method="post" action="/polls/<%= poll.id %>/options" enctype="multipart/form-data" class="option-block">
    <label>Intitulé (optionnel si image)</label>
    <input type="text" name="label" placeholder="Nouvelle option">
    <label>Description (optionnelle)</label>
    <input type="text" name="description" placeholder="Précisions…">
    <label>Image (optionnelle, 3 Mo max)</label>
    <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif">
    <button class="btn btn-sm" type="submit" style="margin-top:12px">+ Ajouter l'option</button>
  </form>
</div>

<div class="card">
  <h2 style="margin-top:0">Confidentialité</h2>
  <p style="margin-top:0">
    Ce scrutin est actuellement
    <% if (poll.is_nominative) { %><strong style="color:#b45309">nominatif</strong> — les votes ne sont pas secrets, les identités et votes individuels sont visibles ci-dessous.
    <% } else { %><strong>secret</strong> — aucun lien n'existe entre les votants et leurs bulletins.<% } %>
  </p>
  <form method="post" action="/polls/<%= poll.id %>/nominative">
    <% if (poll.is_nominative) { %>
      <input type="hidden" name="nominative" value="off">
      <button class="btn btn-sm btn-ghost" type="submit" onsubmit="return confirm('Repasser en vote secret ? Les identités ne seront plus affichées.')">Repasser en vote secret</button>
    <% } else { %>
      <input type="hidden" name="nominative" value="on">
      <button class="btn btn-sm btn-ghost" type="submit">Passer en scrutin nominatif</button>
    <% } %>
  </form>
  <p class="field-hint">Passer en nominatif ne dé-anonymise pas les votes déjà déposés (ils restent secrets) : seuls les votes suivants seront identifiables, et les votants en sont informés sur le bulletin.</p>
</div>

<div class="card">
  <h2 style="margin-top:0">Participation</h2>
  <p><strong><%= voterStats.voted %></strong> vote<%= voterStats.voted > 1 ? 's' : '' %> exprimé<%= voterStats.voted > 1 ? 's' : '' %>
     · <%= voterStats.invited %> personne<%= voterStats.invited > 1 ? 's' : '' %> ayant demandé un lien.</p>
</div>

<% if (poll.is_nominative) { %>
<div class="card">
  <h2 style="margin-top:0">Participants <span class="muted" style="font-size:14px">(scrutin nominatif)</span></h2>
  <% if (!participants || participants.length === 0) { %>
    <p class="muted">Personne n'a encore demandé de lien de vote.</p>
  <% } else { %>
    <div style="overflow-x:auto">
      <table class="results">
        <thead>
          <tr>
            <th>Participant</th>
            <th>Statut</th>
            <% options.forEach(function (o) { %>
              <th style="text-align:center;min-width:56px"><%= o.label ? o.label : '(image)' %></th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% participants.forEach(function (p) { %>
            <tr>
              <td>
                <% if (p.name) { %><strong><%= p.name %></strong><br><% } %>
                <span class="muted" style="font-size:13px"><%= p.email || '—' %></span>
              </td>
              <td>
                <% if (!p.voted) { %><span class="badge badge-closed">pas voté</span>
                <% } else if (p.anonymous) { %><span class="badge badge-private">voté (anonyme)</span>
                <% } else { %><span class="badge badge-open">voté</span><% } %>
              </td>
              <% options.forEach(function (o) { %>
                <td style="text-align:center">
                  <% if (p.scores && Object.prototype.hasOwnProperty.call(p.scores, o.id)) { var s = p.scores[o.id]; %>
                    <span class="total <%= s > 0 ? 'pos' : (s < 0 ? 'neg' : '') %>"><%= s > 0 ? '+' + s : s %></span>
                  <% } else { %><span class="muted">—</span><% } %>
                </td>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="field-hint" style="margin-top:10px">Notes de −2 à +2 (0 = neutre). « — » : option ajoutée après le vote de la personne. « voté (anonyme) » : bulletin déposé avant le passage en nominatif, non ré-associable.</p>
  <% } %>
</div>
<% } %>

<div class="card">
  <h2 style="margin-top:0">Résultats <span class="muted" style="font-size:14px">(en tant que créateur, visibles à tout moment)</span></h2>
  <% if (ballotCount === 0) { %>
    <p class="muted">Aucun bulletin pour l'instant.</p>
  <% } else { %>
    <%- include('partials/results_table', { options: results, ballotCount: ballotCount }) %>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0">Administration</h2>
  <div class="row-actions">
    <% if (poll.status === 'open') { %>
      <form method="post" action="/polls/<%= poll.id %>/status"><input type="hidden" name="status" value="closed"><button class="btn btn-sm btn-ghost" type="submit">Clôturer le vote</button></form>
    <% } else { %>
      <form method="post" action="/polls/<%= poll.id %>/status"><input type="hidden" name="status" value="open"><button class="btn btn-sm btn-ghost" type="submit">Rouvrir le vote</button></form>
    <% } %>
    <form method="post" action="/polls/<%= poll.id %>/delete" onsubmit="return confirm('Supprimer définitivement ce vote et tous ses bulletins ?')">
      <button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
