{
  "name": "vote-de-valeur",
  "version": "0.1.0",
  "description": "Plateforme de vote de valeur (range voting -2..+2)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
