# Copiez ce fichier en .env, ou lancez `npm run init-env` qui génère les secrets.
# Ne commitez jamais le fichier .env.

# === Application ===
PORT=3000
# URL publique de base (sans slash final) : sert à générer les liens envoyés par email.
BASE_URL=http://localhost:3000
# Nombre de proxys de confiance devant l'app (1 derrière Traefik/Coolify), pour la limitation de débit.
TRUST_PROXY=0

# === Secrets (32 caractères minimum, obligatoires en production) ===
# Générer chaque valeur avec : openssl rand -hex 32
# Signe les cookies de session.
JWT_SECRET=
# Clé HMAC des identifiants des votants (unicité du vote sans les stocker en clair).
EMAIL_HASH_SECRET=
# Mot de passe de la base PostgreSQL créée par docker compose (caractères hexadécimaux conseillés).
POSTGRES_PASSWORD=

# === Base de données (développement sans Docker) ===
# Soit DATABASE_URL, soit les variables PG* individuelles. Ignoré par docker compose.
DATABASE_URL=postgres://vote:mot-de-passe-local@localhost:5432/vote_de_valeur

# === Email transactionnel (SMTP) ===
# Compatible Resend / Postmark / Brevo / Mailgun / etc.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vote de valeur <noreply@example.com>"
# true : aucun email envoyé, les liens de vote s'affichent dans la console (développement).
SMTP_DEV_MODE=true
