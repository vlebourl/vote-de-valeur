# === Application ===
PORT=3000
# URL publique de base (sans slash final) — sert à générer les liens de partage et magiques
BASE_URL=http://localhost:3000
# Secret pour signer les cookies de session (JWT). Générer une longue chaîne aléatoire.
JWT_SECRET=change-me-please-with-a-long-random-string
# Clé HMAC pour hasher les emails des votants (préserve le secret du bulletin).
EMAIL_HASH_SECRET=change-me-too-another-long-random-string

# === Base de données Postgres ===
# Soit DATABASE_URL, soit les variables PG* individuelles.
DATABASE_URL=postgres://vote:vote@localhost:5432/vote_de_valeur
# PGHOST=localhost
# PGPORT=5432
# PGUSER=vote
# PGPASSWORD=vote
# PGDATABASE=vote_de_valeur

# === Email transactionnel (SMTP) ===
# Compatible Resend / Postmark / Brevo / Mailgun / etc.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-api-key-here
SMTP_FROM="Vote de valeur <noreply@ton-domaine.fr>"
# Mettre à true pour désactiver l'envoi réel et afficher les liens magiques dans les logs (dev).
SMTP_DEV_MODE=true
